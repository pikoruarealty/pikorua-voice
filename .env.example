# ─────────────────────────────────────────────────────────────────────────────
# Pikorua Voice — environment configuration
# Copy to .env at the repo root:  cp .env.example .env
#
# This service is STANDALONE: it owns its PostgreSQL + Redis instances and runs
# on distinct ports from the CRM / ai-leads repos so all three can run together.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=4100
API_AUTH_TOKEN=""

# ─── Database · Neon ─────────────────────────────────────────────────────────
# Copy from: Neon dashboard → your project → Connection string (pooled)
DATABASE_URL=""

# ─── Redis · Upstash ──────────────────────────────────────────────────────────
# Copy from: Upstash dashboard → your database → Redis URL (rediss://...)
REDIS_URL=""

# ─── Telephony · Exotel (outbound dialing + webhooks — Step 6/7) ─────────────
EXOTEL_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"
# Your Exotel virtual number (ExoPhone) — from Exotel dashboard → Phone Numbers
EXOTEL_CALLER_ID=""
# Voicebot App ID — from Exotel App Builder after creating the Voicebot applet
EXOTEL_APP_ID=""
EXOTEL_WEBHOOK_SECRET=""
# Optional: shared secret for the Voicebot WebSocket endpoint (/exotel-stream).
# Set this and append ?token=<value> to the WebSocket URL in the Exotel applet.
EXOTEL_STREAM_SECRET=""
# Render service URL (derived from service name in render.yaml)
PUBLIC_BASE_URL="http://localhost:4100"

# Worker's URL — the API pings it whenever it queues work (post-call after any
# inbound/outbound call, or an outbound dial) so a spun-down free-tier worker wakes
# and drains the queue. Leave blank locally (worker runs alongside the API).
# WORKER_WAKE_URL="https://pikorua-voice-web-worker.onrender.com/health"
# Business-hours (IST) window the API keeps the worker warm for the time-driven
# reminder/feedback scheduler; outside it, the worker is woken just before a reminder
# is due. Defaults 10-18. Set start >= end to disable the window (wake-ahead stays on).
# WORKER_KEEPALIVE_START_HOUR_IST="10"
# WORKER_KEEPALIVE_END_HOUR_IST="18"

# ─── Voice routing ───────────────────────────────────────────────────────────
CALL_LOCALE_DEFAULT="hi-IN"
# "openrouter" = force OpenRouter only; leave blank for auto
LLM_PROVIDER_OVERRIDE=""
# Keep true in production; set false for low-quota local demos.
GUARDRAIL_SEMANTIC_ENABLED=true
STT_STREAMING_ENABLED=false
TTS_WS_STREAMING_ENABLED=false
# Per-OpenRouter-request timeout (ms) and per-turn watchdog (ms).
OPENROUTER_TIMEOUT_MS=4000
TURN_TIMEOUT_MS=12000
# ElevenLabs request timeout (ms).
TTS_TIMEOUT_MS=8000
# Hard cap on a single call's length (ms); 0 disables. Default 3 min.
CALL_MAX_DURATION_MS=180000
# Consecutive silent/noise turns (within a 45s window) before assuming the line
# is dead and hanging up.
SILENCE_END_THRESHOLD=3
# Sliding-window cap on conversation history messages sent to the LLM.
LLM_HISTORY_MAX_MESSAGES=20

# ─── Speech-to-Text · Deepgram (Step 8) ──────────────────────────────────────
DEEPGRAM_API_KEY=""

# ─── Inbound AGC (telephony only — boosts soft-spoken callers before STT) ─────
# The Exotel gateway lifts a quiet caller's PCM toward a target level BEFORE it
# reaches Deepgram, so soft speakers aren't misheard/dropped. Boost-only,
# noise-gated, peak-limited (cannot clip), and applied AT ALL TIMES — including
# while Maya speaks. Gating it on her silence left a soft caller unheard during her
# turn and its tail, so the loudest thing on the line won. Her own echo is rejected
# by the near-end energy gates below, not by muting the boost.
# These are read directly from process.env by exotel-voicebot.gateway.ts (not the
# zod schema); a non-numeric/≤0 value falls back to the default shown.
# Kill-switch: set to "0" to send raw caller audio straight to STT.
STT_INBOUND_AGC="1"
# Target RMS for boosted speech (~-18 dBFS @ 16-bit full scale).
STT_INBOUND_AGC_TARGET_RMS=4000
# Hard cap on boost so a near-silent line isn't multiplied into amplified noise.
STT_INBOUND_AGC_MAX_GAIN=12
# Peak ceiling the boosted signal must never exceed (~-1 dBFS) — guarantees no clip.
STT_INBOUND_AGC_PEAK_CEILING=29000
# Frames quieter than this RMS are treated as hiss/silence and held near 1×.
STT_INBOUND_AGC_NOISE_GATE_RMS=55

# ─── Near-end / double-talk detection (telephony only) ───────────────────────
# The caller is amplified at ALL times (above), so while Maya speaks her own echo
# (no carrier echo-cancellation) and room background get boosted too. These gates
# decide what counts as GENUINE caller speech, measured on the raw pre-boost frame
# against the line's adaptive noise floor. Echo/chatter sit at the floor and are
# rejected; a real caller stands above it. Read directly from process.env by
# exotel-voicebot.gateway.ts; a non-numeric/≤0 value falls back to the default.
# How far above the adaptive floor (×) counts as real near-end speech.
STT_NEAR_END_MARGIN=2.2
# Absolute RMS guard so a near-silent line's tiny floor×margin can't accept hiss.
STT_NEAR_END_MIN_RMS=70
# How long near-end "speaking" is held after the last loud frame. MUST stay above
# Deepgram's utterance_end_ms (1000) — the gate is checked when the FINAL transcript
# lands, not when the caller spoke, so a shorter hold makes a real utterance look
# like echo and get dropped (Maya goes deaf on noisy lines).
STT_NEAR_END_HOLD_MS=1500

# ─── Outbound greeting hold (telephony only) ─────────────────────────────────
# Exotel bridges the callee's media leg a beat AFTER the Voicebot `start` fires, so
# greeting audio sent in that gap is dropped and the callee hears only the tail of
# Maya's intro. Hold the opening greeting (and STT) on OUTBOUND calls until the
# callee is heard ("hello?"), at most this long. Inbound calls are never held.
# Set 0 to disable.
OUTBOUND_GREETING_DELAY_MS=3000

# ─── Call capacity (shared by API + worker via Redis) ────────────────────────
# At most MAX_CONCURRENT_CALLS at once, of which OUTBOUND_MAX_CONCURRENT outbound
# (the rest stays free for inbound callers). Set the SAME values on the worker.
MAX_CONCURRENT_CALLS=2
OUTBOUND_MAX_CONCURRENT=1
# On deploy/SIGTERM, wait this long for live calls to finish before exiting.
DRAIN_TIMEOUT_MS=230000

# ─── Cloudflare Tunnel (deploy/README.md §2) ─────────────────────────────────
# Cloudflare dashboard → Zero Trust → Networks → Tunnels → your tunnel → token.
CLOUDFLARE_TUNNEL_TOKEN=""

# ─── Operator pages ──────────────────────────────────────────────────────────
# Password for / (browser test-call demo) and /status (service dashboard). Browser
# login box: any username, this password. Unset in production = pages disabled.
DASHBOARD_PASSWORD=""

# ─── Cost page (/costs) rates — list prices, check your plans ─────────────────
USD_INR=85
SARVAM_TTS_INR_PER_10K_CHARS=30
STT_INR_PER_HOUR=30
# Your Exotel per-minute rate for connected calls. 0 = phone cost left out of /costs.
EXOTEL_INR_PER_MIN=0

# ─── Reply latency ───────────────────────────────────────────────────────────
# Caller paused mid-sentence ("…और"): answer what they said after this much more
# silence (0 = wait for them indefinitely).
STT_FRAGMENT_WAIT_MS=800
# No reply audio yet this long after the caller finished → play a recorded filler
# ("जी।") so the line is never silent longer than this (0 = off).
TURN_FILLER_DELAY_MS=600

# ─── Text-to-Speech · ElevenLabs (Step 8) ────────────────────────────────────
ELEVENLABS_API_KEY=""
# Pick an Indian multilingual voice from the ElevenLabs voice library
ELEVENLABS_VOICE_ID=""
# Voice tuning (optional overrides — defaults tuned for a natural conversational tone)
# Consistency dial: too low drifts tone turn-to-turn, too high goes monotone. 0.60 = steady tone + smile.
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.9
# Style = the "smile"/warmth dial. 0.45 = warm, smiling delivery; >0.5 gets theatrical.
ELEVENLABS_STYLE=0.45
# Playback speed — ElevenLabs accepts 0.7–1.2 only (1.0 = natural). Default 1.1 for a slightly brisker pace.
ELEVENLABS_SPEED=1.1
# TTS model + forced pronunciation language ("hi" = read romanized Hindi correctly)
ELEVENLABS_MODEL="eleven_turbo_v2_5"
ELEVENLABS_LANGUAGE_CODE="hi"

# ─── Text-to-Speech · Sarvam (GUJARATI ONLY) ─────────────────────────────────
# ElevenLabs CANNOT speak Gujarati — the Indian multilingual voice renders it as
# accented Hindi — so gu-IN is synthesized by Sarvam Bulbul v3 instead. TtsRouter
# picks the vendor from the call locale; hi/en never touch Sarvam.
#
# KILL SWITCH: with SARVAM_API_KEY blank (or SARVAM_TTS_ENABLED=false), Gujarati
# silently falls back to the HINDI persona rather than failing the call — a healthy
# call in every log, the wrong language to the caller. The mid-call switch INTO
# gu-IN is gated on the same flag, so STT can never run in Gujarati while the reply
# comes back in Hindi. Leaving this blank is a supported hi/en-only deployment.
SARVAM_API_KEY=""
SARVAM_TTS_ENABLED=true
# Maya's voice in all three languages: "Aparna" on bulbul:v4-flash, at 8kHz —
# exactly Exotel's wire format, so there is no resampling step. v4 voice IDs are
# per language; the Hindi Aparna also voices Gujarati (no Gujarati Aparna exists).
# (Replaces SARVAM_MODEL / SARVAM_SPEAKER, which are no longer read.)
SARVAM_TTS_MODEL="bulbul:v4-flash"
SARVAM_SPEAKER_HI="aparna_hi_customer"
SARVAM_SPEAKER_EN="aparna_en_companion"
SARVAM_SPEAKER_GU="aparna_hi_customer"
# Speaking rate, chosen BY EAR: 1.0 = natural speed. Keep this in step with the zod
# default in apps/api/src/config/env.ts — the schema default is what production
# actually gets if this is unset.
SARVAM_PACE=1.0
# Per-synthesis variation. This is why the opening greeting is re-synthesized every
# call instead of cached: an earlier build cached one take and replayed it, every
# call became bit-identical, and callers heard it as robotic.
SARVAM_TEMPERATURE=0.7
# Sarvam-side text normalization.
SARVAM_PREPROCESS=true
# Hindi/English voice: "sarvam" (default — the same Aparna voice as Gujarati, ≈ half
# the TTS cost) or "elevenlabs". ElevenLabs stays the automatic fallback.
TTS_PROVIDER_HI=sarvam

# ─── Speech-to-Text provider ─────────────────────────────────────────────────
# "sarvam" (default, cheaper) or "deepgram". Deepgram stays the automatic mid-call
# fallback when Sarvam fails, so keep DEEPGRAM_API_KEY set either way.
STT_PROVIDER=sarvam
SARVAM_STT_MODEL="saaras:v4"

# ─── LLM · OpenRouter (primary → fallback chain) ─────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4-5"
# Optional second model tried only if OPENROUTER_MODEL fails 3x. WARNING: the
# fallback must honour the same persona constraints (Devanagari-only Hindi,
# feminine verb forms, the <end_call/> token, never quoting prices). A weak/free
# model here can produce romanized Hindi or break the call-end signal on exactly
# the turns where the primary is already struggling. Leave blank to disable.
OPENROUTER_FALLBACK_MODEL=""

# ─── CRM integration (REST only — Step 9) ────────────────────────────────────
# Base URL of the CRM's Voice ingestion API. After every call the worker POSTs the
# lead score, transcript, objections and appointment to <CRM_API_BASE_URL>/call-results.
#
# BASE ONLY — "/call-results" is appended in code (crm-client.ts). Putting the full
# endpoint here POSTs to …/call-results/call-results and every sync 404s.
#
# Production: https://crm.pikoruarealty.com/api/v1/voice   (set in render.yaml)
#
# Left on the local mock here on purpose: pointing a dev machine at the production
# base writes real leads into the live CRM from test calls. Use the bundled mock
# (node tools/e2e/mock-crm/server.js) unless you specifically mean to hit prod.
CRM_API_BASE_URL="http://localhost:4000"
# Shared Bearer token the CRM validates on every request (their VOICE_API_BEARER_TOKEN).
CRM_API_TOKEN=""
# Shared HMAC-SHA256 secret used to sign the X-Signature header over the raw request
# body (their VOICE_WEBHOOK_HMAC_SECRET). Leave blank to send unsigned (CRM will 403).
CRM_WEBHOOK_HMAC_SECRET=""

# ─── Worker: free-tier keep-alive (optional) ─────────────────────────────────
# The worker's OWN self-ping. Prefer the API-driven WORKER_WAKE_URL above: a
# self-ping cannot revive a worker that has ALREADY slept (e.g. 10 AM after an
# overnight idle), which is exactly when it matters.
WORKER_KEEPALIVE_ENABLED="false"
# This worker's own public URL — required when the self-ping is enabled.
# WORKER_PUBLIC_URL="https://pikorua-voice-web-worker.onrender.com"

# ─── Worker: post-call LLM scoring (optional — falls back to heuristics) ──────
LLM_SCORING_PROVIDER="auto"
# Override the model used for scoring (defaults to OPENROUTER_MODEL above).
# LLM_SCORING_MODEL=""

# ─── Worker: site-visit appointments (#2 reconfirmation + #4 feedback) ────────
# The reconfirmation (T-24h / T-2h) and post-visit feedback calls place REAL
# outbound calls, so they are OFF by default — flip to "true" to enable. When off,
# appointments are still created (auto + API) and objections are still captured;
# only the outbound dialing is gated. Existing do_not_call opt-outs are always honored.
APPOINTMENTS_OUTBOUND_ENABLED="false"
# How long after the visit the post-visit feedback call fires (ms; default 3h).
APPOINTMENT_FEEDBACK_DELAY_MS="10800000"
