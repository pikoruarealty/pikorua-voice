# ─────────────────────────────────────────────────────────────────────────────
# Pikorua Voice — environment configuration
# Copy to .env at the repo root:  cp .env.example .env
#
# This service is STANDALONE: it owns its PostgreSQL + Redis instances and runs
# on distinct ports from the CRM / ai-leads repos so all three can run together.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=4100
API_AUTH_TOKEN=""

# ─── Database (docker-compose maps host 5433 → container 5432) ───────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pikorua_voice"

# ─── Redis (docker-compose maps host 6380 → container 6379) ──────────────────
REDIS_URL="redis://localhost:6380"

# ─── Telephony · Exotel (outbound dialing + webhooks — Step 6/7) ─────────────
EXOTEL_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_CALLER_ID=""
EXOTEL_WEBHOOK_SECRET=""
# Publicly reachable base URL Exotel calls back to (e.g. an https tunnel)
PUBLIC_BASE_URL="http://localhost:4100"

# ─── Voice routing ───────────────────────────────────────────────────────────
GEMINI_LANGUAGE_DEFAULT="hi-IN"
# Optional: force all turns to one provider ("openrouter" or "google"). Leave blank for auto.
LLM_PROVIDER_OVERRIDE=""
# Keep true in production; set false for low-quota local demos.
GUARDRAIL_SEMANTIC_ENABLED=true
STT_REALTIME_ENABLED=false
STT_STREAMING_ENABLED=false

# ─── Speech-to-Text · Deepgram (Step 8) ──────────────────────────────────────
DEEPGRAM_API_KEY=""

# ─── Text-to-Speech · ElevenLabs (Step 8) ────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ─── LLM · Google Generative AI (fallback — Step 8/9) ────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_MODEL="gemini-2.0-flash"

# ─── CRM integration (REST only — Step 9) ────────────────────────────────────
CRM_API_BASE_URL="http://localhost:4000"
CRM_API_TOKEN=""

# ─── Worker: post-call LLM scoring (optional — falls back to heuristics) ──────
# LLM_SCORING_PROVIDER controls which provider is used for lead scoring.
# Defaults to "auto" (OpenRouter first, then Google).
LLM_SCORING_PROVIDER="auto"
# Override the model used for scoring (defaults to OPENROUTER_MODEL / GOOGLE_MODEL above).
# LLM_SCORING_MODEL=""
