# ─────────────────────────────────────────────────────────────────────────────
# Pikorua Voice — environment configuration
# Copy to .env at the repo root:  cp .env.example .env
#
# This service is STANDALONE: it owns its PostgreSQL + Redis instances and runs
# on distinct ports from the CRM / ai-leads repos so all three can run together.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=4100
API_AUTH_TOKEN=""

# ─── Database · Neon ─────────────────────────────────────────────────────────
# Copy from: Neon dashboard → your project → Connection string (pooled)
DATABASE_URL=""

# ─── Redis · Upstash ──────────────────────────────────────────────────────────
# Copy from: Upstash dashboard → your database → Redis URL (rediss://...)
REDIS_URL=""

# ─── Telephony · Exotel (outbound dialing + webhooks — Step 6/7) ─────────────
EXOTEL_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"
# Your Exotel virtual number (ExoPhone) — from Exotel dashboard → Phone Numbers
EXOTEL_CALLER_ID=""
# Voicebot App ID — from Exotel App Builder after creating the Voicebot applet
EXOTEL_APP_ID=""
EXOTEL_WEBHOOK_SECRET=""
# Optional: shared secret for the Voicebot WebSocket endpoint (/exotel-stream).
# Set this and append ?token=<value> to the WebSocket URL in the Exotel applet.
EXOTEL_STREAM_SECRET=""
# Render service URL (derived from service name in render.yaml)
PUBLIC_BASE_URL="http://localhost:4100"

# Worker's URL — the API pings it whenever it queues work (post-call after any
# inbound/outbound call, or an outbound dial) so a spun-down free-tier worker wakes
# and drains the queue. Leave blank locally (worker runs alongside the API).
# WORKER_WAKE_URL="https://pikorua-voice-worker.onrender.com/health"

# ─── Voice routing ───────────────────────────────────────────────────────────
CALL_LOCALE_DEFAULT="hi-IN"
# "openrouter" = force OpenRouter only; leave blank for auto
LLM_PROVIDER_OVERRIDE=""
# Keep true in production; set false for low-quota local demos.
GUARDRAIL_SEMANTIC_ENABLED=true
STT_STREAMING_ENABLED=false
TTS_WS_STREAMING_ENABLED=false
# Per-OpenRouter-request timeout (ms) and per-turn watchdog (ms).
OPENROUTER_TIMEOUT_MS=4000
TURN_TIMEOUT_MS=12000
# ElevenLabs request timeout (ms).
TTS_TIMEOUT_MS=8000
# Hard cap on a single call's length (ms); 0 disables. Default 15 min.
CALL_MAX_DURATION_MS=900000
# Consecutive silent/noise turns (within a 45s window) before assuming the line
# is dead and hanging up.
SILENCE_END_THRESHOLD=3
# Sliding-window cap on conversation history messages sent to the LLM.
LLM_HISTORY_MAX_MESSAGES=20

# ─── Speech-to-Text · Deepgram (Step 8) ──────────────────────────────────────
DEEPGRAM_API_KEY=""

# ─── Inbound AGC (telephony only — boosts soft-spoken callers before STT) ─────
# The Exotel gateway lifts a quiet caller's PCM toward a target level BEFORE it
# reaches Deepgram, so soft speakers aren't misheard/dropped. Boost-only,
# noise-gated, peak-limited (cannot clip), and applied only while Maya is silent.
# These are read directly from process.env by exotel-voicebot.gateway.ts (not the
# zod schema); a non-numeric/≤0 value falls back to the default shown.
# Kill-switch: set to "0" to send raw caller audio straight to STT.
STT_INBOUND_AGC="1"
# Target RMS for boosted speech (~-18 dBFS @ 16-bit full scale).
STT_INBOUND_AGC_TARGET_RMS=4000
# Hard cap on boost so a near-silent line isn't multiplied into amplified noise.
STT_INBOUND_AGC_MAX_GAIN=12
# Peak ceiling the boosted signal must never exceed (~-1 dBFS) — guarantees no clip.
STT_INBOUND_AGC_PEAK_CEILING=29000
# Frames quieter than this RMS are treated as hiss/silence and held near 1×.
STT_INBOUND_AGC_NOISE_GATE_RMS=55

# ─── Text-to-Speech · ElevenLabs (Step 8) ────────────────────────────────────
ELEVENLABS_API_KEY=""
# Pick an Indian multilingual voice from the ElevenLabs voice library
ELEVENLABS_VOICE_ID=""
# Voice tuning (optional overrides — defaults tuned for a natural conversational tone)
# Consistency dial: too low drifts tone turn-to-turn, too high goes monotone. 0.60 = steady tone + smile.
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.9
# Style = the "smile"/warmth dial. 0.45 = warm, smiling delivery; >0.5 gets theatrical.
ELEVENLABS_STYLE=0.45
# Playback speed — ElevenLabs accepts 0.7–1.2 only (1.0 = natural). Default 1.1 for a slightly brisker pace.
ELEVENLABS_SPEED=1.1
# TTS model + forced pronunciation language ("hi" = read romanized Hindi correctly)
ELEVENLABS_MODEL="eleven_turbo_v2_5"
ELEVENLABS_LANGUAGE_CODE="hi"

# ─── LLM · OpenRouter (primary → fallback chain) ─────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4-5"
# Optional second model tried only if OPENROUTER_MODEL fails 3x. WARNING: the
# fallback must honour the same persona constraints (Devanagari-only Hindi,
# feminine verb forms, the <end_call/> token, never quoting prices). A weak/free
# model here can produce romanized Hindi or break the call-end signal on exactly
# the turns where the primary is already struggling. Leave blank to disable.
OPENROUTER_FALLBACK_MODEL=""

# ─── CRM integration (REST only — Step 9) ────────────────────────────────────
# Base URL of the custom CRM's Voice ingestion API. The worker POSTs completed
# calls to <CRM_API_BASE_URL>/call-results, so include the CRM team's /api/v1/voice
# prefix here, e.g. https://crm.example.com/api/v1/voice
CRM_API_BASE_URL="http://localhost:4000"
# Shared Bearer token the CRM validates on every request (their VOICE_API_BEARER_TOKEN).
CRM_API_TOKEN=""
# Shared HMAC-SHA256 secret used to sign the X-Signature header over the raw request
# body (their VOICE_WEBHOOK_HMAC_SECRET). Leave blank to send unsigned (CRM will 403).
CRM_WEBHOOK_HMAC_SECRET=""

# ─── Worker: post-call LLM scoring (optional — falls back to heuristics) ──────
LLM_SCORING_PROVIDER="auto"
# Override the model used for scoring (defaults to OPENROUTER_MODEL above).
# LLM_SCORING_MODEL=""

# ─── Worker: site-visit appointments (#2 reconfirmation + #4 feedback) ────────
# The reconfirmation (T-24h / T-2h) and post-visit feedback calls place REAL
# outbound calls, so they are OFF by default — flip to "true" to enable. When off,
# appointments are still created (auto + API) and objections are still captured;
# only the outbound dialing is gated. Existing do_not_call opt-outs are always honored.
APPOINTMENTS_OUTBOUND_ENABLED="false"
# How long after the visit the post-visit feedback call fires (ms; default 3h).
APPOINTMENT_FEEDBACK_DELAY_MS="10800000"
