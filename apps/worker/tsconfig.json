{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@pikorua/shared": ["../../packages/shared/dist/index.d.ts"],
      "@pikorua/shared/*": ["../../packages/shared/dist/*"],
      "@pikorua/db": ["../../packages/db/dist/index.d.ts"],
      "@pikorua/db/*": ["../../packages/db/dist/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
